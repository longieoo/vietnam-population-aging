model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: vi-VN
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["Master","DimCountry","FocusCountry","ComparisonCountry","DimYear","SelectedYear","PeriodChanges","Thresholds","ThresholdSelect","Metrics","SourceRoot"]

ref table Master
ref table DimCountry
ref table FocusCountry
ref table ComparisonCountry
ref table DimYear
ref table SelectedYear
ref table PeriodChanges
ref table Thresholds
ref table ThresholdSelect
ref table Metrics

ref cultureInfo en-US

