	measure 'GDP tại ngưỡng' = VAR t = SELECTEDVALUE(ThresholdSelect[threshold], 10) VAR c = SELECTEDVALUE(DimCountry[iso3]) RETURN IF(c IN VALUES(ComparisonCountry[iso3]), CALCULATE(AVERAGE('Thresholds'[gdp_ppp]), 'Thresholds'[status] = "observed", TREATAS({t}, 'Thresholds'[threshold])))
