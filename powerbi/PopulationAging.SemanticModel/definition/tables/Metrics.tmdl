	measure 'Pearson r · GDP' = VAR pts = FILTER(ADDCOLUMNS(ALLSELECTED(DimCountry[iso3]), "_x", [Hiện trạng · GDP PPP/người], "_y", [Hiện trạng · 65+ tuổi (%)]), NOT ISBLANK([_x]) && NOT ISBLANK([_y])) VAR ax = AVERAGEX(pts, [_x]) VAR ay = AVERAGEX(pts, [_y]) RETURN DIVIDE(SUMX(pts, ([_x]-ax)*([_y]-ay)), SQRT(SUMX(pts, ([_x]-ax)^2)*SUMX(pts, ([_y]-ay)^2)))
		formatString: 0.000
		displayFolder: Mẫu
		lineageTag: c94e726e-739c-4a63-affa-d6b9a13024f1

