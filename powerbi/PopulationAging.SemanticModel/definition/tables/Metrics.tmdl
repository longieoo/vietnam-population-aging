	measure 'Năm đầu quan sát tại ngưỡng' = VAR t = SELECTEDVALUE(ThresholdSelect[threshold], 10) VAR c = SELECTEDVALUE(DimCountry[iso3]) RETURN IF(c IN VALUES(ComparisonCountry[iso3]), CALCULATE(MAX('Thresholds'[year]), 'Thresholds'[status] = "observed", TREATAS({t}, 'Thresholds'[threshold])))
