	measure 'Trạng thái ngưỡng' = VAR t = SELECTEDVALUE(ThresholdSelect[threshold], 10) VAR c = SELECTEDVALUE(DimCountry[iso3]) VAR s = CALCULATE(SELECTEDVALUE('Thresholds'[status]), TREATAS({t}, 'Thresholds'[threshold])) RETURN IF(c IN VALUES(ComparisonCountry[iso3]), SWITCH(s, "observed", "Quan sát được", "already_above", "Đã ở trên ngưỡng năm 1991", "not_reached", "Chưa đạt đến năm 2023", "gap_uncertain", "Khoảng trống dữ liệu", s))
		displayFolder: Ngưỡng
		lineageTag: 2bb1bebf-7cc0-4bb0-8fca-dbe4ac007cfa

	measure 'Số quan sát · GDP' = COUNTROWS(FILTER(ADDCOLUMNS(ALLSELECTED(DimCountry[iso3]), "_x", [Hiện trạng · GDP PPP/người], "_y", [Hiện trạng · 65+ tuổi (%)]), NOT ISBLANK([_x]) && NOT ISBLANK([_y])))
